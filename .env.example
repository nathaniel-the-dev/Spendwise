# SpendWise Environment Variables

# Supabase (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
NEXT_PUBLIC_SUPPORT_EMAIL=

# Support contact form (server-only — never expose the token to the client).
# Create a fine-grained PAT scoped to Issues:Write on the one repo below.
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=nathaniel-the-dev/Spendwise

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
